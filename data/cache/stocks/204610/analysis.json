0.0,170.0,170.0,170.0,170.0,170.0,170.0,170.0,170.0],"y":[6.569,6.196,6.0,5.96,5.96,6.061,5.99,5.99,5.892,5.95,6.081,6.03,6.05,6.207,6.196,6.272,6.175,6.283,6.175,6.294,6.417,6.175,5.583,5.502,5.502,5.484,5.113,4.942,5.03,5.12,5.152,5.167,5.082,5.183,5.167,5.128,5.183,5.175,5.105,5.03,5.082,5.159,5.037,5.159,5.191,5.255,5.152,5.175,5.247,5.223,5.263,5.414,5.304,5.346,5.546,5.592,5.583,5.724,5.724,5.705,5.822],"u":[4.38,4.44,4.48,4.49,4.49,4.48,4.55,4.56,4.54,4.56,4.62,4.58,4.55,4.55,4.6,4.63,4.67,4.71,4.69,4.65,4.61,4.67,4.68,4.75,4.7,4.63,4.63,4.69,4.65,4.72,4.7,4.68,4.63,4.72,4.71,4.65,4.69,4.74,4.7,4.64,4.66,4.67,4.73,4.75,4.79,4.79,4.77,4.78,4.78,4.8,4.83,4.95,4.96,4.97,5.0,5.01,4.94,5.01,4.96,4.96,5.17],"m":[1.5,1.396,1.339,1.327,1.327,1.353,1.316,1.314,1.298,1.305,1.316,1.317,1.33,1.364,1.347,1.355,1.322,1.334,1.317,1.353,1.392,1.322,1.193,1.158,1.171,1.184,1.104,1.054,1.082,1.085,1.096,1.104,1.098,1.098,1.097,1.103,1.105,1.092,1.086,1.084,1.091,1.105,1.065,1.086,1.084,1.097,1.08,1.083,1.098,1.088,1.09,1.094,1.069,1.076,1.109,1.116,1.13,1.142,1.154,1.15,1.126]},"rules":["현재 예상 DPS: 기준일까지 공시가 확인된 배당만 사용한다. 미래 배당을 예측하지 않는다.","예상 DPS: 분기배당 기업은 현재 연도에 확정된 분기분을 사용하고, 미확정 분기는 전년도 같은 분기 배당으로 보완한다. 예: 올해 Q1만 확정되면 올해 Q1 + 전년도 Q2 + 전년도 Q3 + 전년도 기말배당을 사용한다. 중간배당 기업은 확정된 올해 중간배당 + 전년도 기말배당을 사용하며, 사업보고서가 제출되면 확정 연간 DPS로 바뀐다.","배당의 '확정일(confirmed_date)'은 해당 금액이 실린 DART 정기보고서 접수일이다. 이사회 배당결정 공시보다 늦으므로 보수적이며, look-ahead bias가 생기지 않는다.","기말배당 = 사업보고서의 연간 주당배당금 − 같은 연도 3분기(없으면 반기·1분기) 보고서의 누적 주당배당금.","역사적 배당/10Y는 각 거래일 T에 confirmed_date ≤ T 인 배당 정보만 사용한다.","미국 10년물은 FRED DGS10. 한국 거래일 T에는 T보다 앞선 날짜 중 가장 최근 값을 쓴다(한국 장 마감 시점에 미국 당일 금리는 아직 없다). 결측을 0으로 채우지 않는다.","미국 10년물이 0% 이하인 날은 배수를 계산하지 않는다(N/A).","주가는 KRX 원주가(비수정) 종가. 분할·병합·무상증자는 KRX 기준가와 전일 종가의 차이로 찾아 과거 DPS를 해당 시점 주식 수 기준으로 환산한다.","연도별 DPS는 사업연도 귀속 기준(중간+분기+기말 합계)이다. 실제 입금 연도와 다를 수 있다.","연도별 DPS 차트의 마지막 해가 빗금으로 표시되면, 그 해 사업보고서가 아직 안 나와 그때까지 확정된 중간·분기배당 및 배당결정 공시 누계만 쓴 잠정치다(기말배당 미포함, 0으로 표시). 사업보고서가 나오면 확정치로 바뀐다.","보통주만 대상으로 한다. 우선주는 DART 보통주 DPS와 달라 제외한다.","데이터가 없는 값은 0이 아니라 N/A로 표시한다.","👑(왕관) 태그: 기준일까지 확정된 최근 10개 사업연도 데이터가 모두 있고, 그 10년 모두 배당을 지급했으며, 10년 안에서 전년 대비 배당이 줄어든 해가 한 번도 없는 경우.","💣(폭탄) 태그: 매년 비슷한 금액을 배당하는 기업과, 어느 한 해 1회성으로 크게 배당해 배당수익률이 왜곡된 기업을 구분하기 위한 태그다. 올해 예상(잠정 포함) DPS가 최근 3개 확정 사업연도 DPS의 중앙값(그 회사의 평소 수준, 최소 2개 연도 필요) 대비 50% 이상 높은 경우에 붙는다. 전년도 1개만 보면 마침 전년도 자체가 낮았거나 높았던 해였을 때 잘못 판정할 수 있어 여러 해의 중앙값을 쓴다."],"metadata":{"code":"204610","name":"티쓰리","market":"KOSDAQ","price_through":"2026-09-28","dividend_through":"2026-09-28","us10y_through":"2026-09-25","created_at":"2026-09-28T22:29:59+09:00","updated_at":"2026-09-28T22:29:59+09:00","last_attempt":"2026-09-28T22:29:59+09:00","last_error":null,"steps":{"prices":{"mode":"initial","added":61,"from":"2026-06-30","recent_first":true,"recent_days":7,"quick_initial":true,"gap_filled":false},"dividends":{"mode":"initial","added":15},"announcements":{"mode":"check","added":7}},"valuation_date":"2026-09-28"}}