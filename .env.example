# 이 파일을 .env 로 복사해서 실제 값을 채우세요. .env는 git에 절대 올리지 않습니다(.gitignore 처리됨).

# OpenDART 인증키 (필수). 발급: https://opendart.fss.or.kr/uss/umt/EgovMberInsertView.do
DART_API_KEY=

# KRX Data Marketplace 계정 (필수, 2026-09부터 비로그인 요청 거절).
# 90일마다 비밀번호를 바꿔야 하며, 바꾼 뒤에는 GitHub Secret도 갱신해야 합니다.
KRX_ID=
KRX_PW=

# FRED API 키 (선택). 없으면 FRED 그래프 CSV 다운로드를 사용합니다(키 불필요, 기능은 동일).
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 하루 OpenDART 호출 예산 (공식 한도 20,000건보다 여유 있게 기본 18000)
DART_DAILY_BUDGET=18000

# 예상 DPS 계산 모드: annual(기본, 요구사항 1-③·17과 일치) | final_only(요구사항 1-①을 글자 그대로)
EXPECTED_DPS_MODE=annual
